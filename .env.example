# Application Secrets
SECRET_KEY=generate_a_secure_random_key_here

# Database Configuration (Optional: defaults to sqlite:///./scanner.db if unset; Render PostgreSQL auto-populates this if attached)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Razorpay / Payment Gateway Config (Optional)
GATEWAY_KEY_ID=rzp_test_xxx
GATEWAY_KEY_SECRET=your_gateway_secret
PREMIUM_PRICE_PAISE=9900

